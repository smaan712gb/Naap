# Copy to .env and fill in. NEVER commit .env.

# --- Required for the agent layer ---
# Sourcing agent (public supplier data ONLY — never customer data).
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# --- Recommended (customer-facing text: darzi instructions, order updates) ---
# Per docs/BLUEPRINT.md rule 4, customer-adjacent generation should run on
# Claude under a DPA. Get one at https://console.anthropic.com
# If unset, the darzi agent falls back to DeepSeek with a warning.
ANTHROPIC_API_KEY=

# --- Payments (Phase 1.5 checkout) ---
# https://dashboard.stripe.com/apikeys — use sk_test_... until launch review.
STRIPE_SECRET_KEY=

# --- Server ---
NAAP_DB_PATH=naap.db
NAAP_ENV=dev
